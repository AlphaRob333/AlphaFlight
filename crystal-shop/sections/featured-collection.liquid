{%- assign collection = section.settings.collection -%}
<div class="page-width section-pad">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if collection != blank -%}
      <a href="{{ collection.url }}">{{ 'collections.view' | t }}</a>
    {%- endif -%}
  </div>
  <ul class="grid" role="list">
    {%- if collection != blank -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li>
          <div class="card">
            <div class="card__media">
              {%- capture name -%}product-{{ i }}{%- endcapture -%}
              {{ name | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <h3 class="card__title">{{ 'onboarding.product_title' | t }}</h3>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 4, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
