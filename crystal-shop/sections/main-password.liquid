<div class="page-width page-width--narrow section-pad center password">
  <p class="label">{{ shop.name }}</p>
  <h1>{{ 'password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password', class: 'search-form' -%}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="password-{{ section.id }}">{{ 'password.label' | t }}</label>
    <input id="password-{{ section.id }}" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
    <button type="submit" class="button">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Password", "tag": "section", "settings": [] }
{% endschema %}
