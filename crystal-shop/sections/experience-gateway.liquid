{%- comment -%}
  Home page gateway: the shopper picks the metaphysical or the mineral experience.
  Each panel links to a collection and stores the choice (assets/experience.js).
{%- endcomment -%}
{%- liquid
  assign meta_url = section.settings.meta_collection.url | default: routes.all_products_collection_url
  assign mineral_url = section.settings.mineral_collection.url | default: routes.all_products_collection_url
-%}
<div class="gateway">
  <header class="gateway__intro">
    <p class="label">{{ shop.name }}</p>
    <h1 class="gateway__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="gateway__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </header>

  <div class="gateway__panels">
    <a
      class="gateway__panel gateway__panel--metaphysical scheme-metaphysical"
      href="{{ meta_url }}"
      data-set-experience="metaphysical"
    >
      {%- if section.settings.meta_image -%}
        {{ section.settings.meta_image | image_url: width: 1600 | image_tag: class: 'gateway__image', loading: 'eager', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
      {%- else -%}
        {% render 'art-metaphysical' %}
      {%- endif -%}
      <div class="gateway__body">
        <p class="label">{{ section.settings.meta_eyebrow }}</p>
        <h2 class="gateway__title">{{ section.settings.meta_title }}</h2>
        <p class="gateway__text">{{ section.settings.meta_text }}</p>
        <ul class="gateway__facets" role="list">
          <li>{{ 'products.intention' | t }}</li>
          <li>{{ 'products.chakra' | t }}</li>
          <li>{{ 'products.zodiac' | t }}</li>
        </ul>
        <span class="button">{{ section.settings.meta_button }}</span>
      </div>
    </a>

    <a
      class="gateway__panel gateway__panel--mineral scheme-mineral"
      href="{{ mineral_url }}"
      data-set-experience="mineral"
    >
      {%- if section.settings.mineral_image -%}
        {{ section.settings.mineral_image | image_url: width: 1600 | image_tag: class: 'gateway__image', loading: 'eager', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
      {%- else -%}
        {% render 'art-mineral' %}
      {%- endif -%}
      <div class="gateway__body">
        <p class="label">{{ section.settings.mineral_eyebrow }}</p>
        <h2 class="gateway__title">{{ section.settings.mineral_title }}</h2>
        <p class="gateway__text">{{ section.settings.mineral_text }}</p>
        <ul class="gateway__facets" role="list">
          <li>{{ 'products.formula' | t }}</li>
          <li>{{ 'products.locality' | t }}</li>
          <li>{{ 'products.hardness' | t }}</li>
        </ul>
        <span class="button">{{ section.settings.mineral_button }}</span>
      </div>
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Experience gateway",
  "tag": "section",
  "class": "section-gateway",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How would you like to explore?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The same stones, seen two ways. You can switch at any time." },
    { "type": "header", "content": "Metaphysical panel" },
    { "type": "collection", "id": "meta_collection", "label": "Collection to open", "info": "Leave empty to open all products." },
    { "type": "image_picker", "id": "meta_image", "label": "Background image", "info": "Replaces the illustration." },
    { "type": "text", "id": "meta_eyebrow", "label": "Eyebrow", "default": "For intention and ritual" },
    { "type": "text", "id": "meta_title", "label": "Title", "default": "The Metaphysical Experience" },
    { "type": "textarea", "id": "meta_text", "label": "Text", "default": "Shop by intention, chakra and zodiac sign. Each stone is listed with its traditional meanings and ways to work with it." },
    { "type": "text", "id": "meta_button", "label": "Button label", "default": "Enter the metaphysical shop" },
    { "type": "header", "content": "Mineral panel" },
    { "type": "collection", "id": "mineral_collection", "label": "Collection to open", "info": "Leave empty to open all products." },
    { "type": "image_picker", "id": "mineral_image", "label": "Background image", "info": "Replaces the illustration." },
    { "type": "text", "id": "mineral_eyebrow", "label": "Eyebrow", "default": "For collectors and the curious" },
    { "type": "text", "id": "mineral_title", "label": "Title", "default": "The Mineral Experience" },
    { "type": "textarea", "id": "mineral_text", "label": "Text", "default": "Shop by species, locality and crystal system. Each specimen is listed with its chemistry, hardness and origin." },
    { "type": "text", "id": "mineral_button", "label": "Button label", "default": "Enter the mineral shop" }
  ],
  "presets": [{ "name": "Experience gateway" }]
}
{% endschema %}
