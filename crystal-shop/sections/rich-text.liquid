<div class="page-width page-width--narrow section-pad rich-text">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="rte">{{ section.settings.text }}</div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your shop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share how you source your stones and what makes your shop different.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
