{%- comment -%}
  Mining game for the mineral experience.
  Each block is a dig site tied to a collection. Shoppers pick a site on the map,
  break rocks, and uncover real in-stock products from that collection, which
  they can then buy at the listed price. Logic lives in assets/mine.js.
{%- endcomment -%}
{{ 'mine.css' | asset_url | stylesheet_tag }}
{%- comment -%} three.js draws the 3D rock face; the game falls back to flat tiles without it. {%- endcomment -%}
<script src="{{ 'three.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mine-3d.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mine.js' | asset_url }}" defer="defer"></script>

<div
  class="mine scheme-mineral"
  data-mine
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-url="{{ routes.cart_url }}"
  data-per-dig="{{ section.settings.per_dig }}"
>
  <div class="mine__map-view" data-mine-map>
    <header class="page-width mine__head">
      <p class="label">{{ 'mine.eyebrow' | t }}</p>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="mine__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <div class="page-width">
      <div class="mine__map">
        <div class="mine__map-inner">
          {% render 'world-map' %}
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="mine__pin"
            data-open-site="{{ block.id }}"
            style="--lat: {{ block.settings.latitude | default: 0 }}; --lon: {{ block.settings.longitude | default: 0 }}; --site: {{ block.settings.color }};"
            {{ block.shopify_attributes }}
          >
            <span class="mine__pin-dot" aria-hidden="true"></span>
            <span class="mine__pin-label">{{ block.settings.title }}</span>
          </button>
        {%- endfor -%}
        </div>
      </div>

      <ol class="mine__sites" role="list">
        {%- for block in section.blocks -%}
          <li>
            <button type="button" class="mine__site-card" data-open-site="{{ block.id }}" style="--site: {{ block.settings.color }};">
              <span class="label">{{ 'mine.site_number' | t: number: forloop.index }}</span>
              <span class="mine__site-name">{{ block.settings.title }}</span>
              <span class="mine__site-minerals">{{ block.settings.minerals }}</span>
              <span class="mine__site-count" data-site-count="{{ block.id }}"></span>
            </button>
          </li>
        {%- endfor -%}
      </ol>

      <p class="mine__log-line">
        <span data-log-total></span>
        <button type="button" class="mine__text-button" data-clear-log hidden>{{ 'mine.clear_log' | t }}</button>
      </p>
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- assign site_collection = block.settings.collection -%}
    <section
      class="mine__site page-width"
      id="site-{{ block.id }}"
      data-mine-site="{{ block.id }}"
      data-rock="{{ block.settings.rock }}"
      data-color="{{ block.settings.color }}"
      style="--site: {{ block.settings.color }};"
      aria-labelledby="site-title-{{ block.id }}"
      hidden
    >
      <button type="button" class="mine__text-button mine__back" data-back>&larr; {{ 'mine.back' | t }}</button>

      <div class="mine__site-layout">
        <div class="mine__site-info">
          <p class="label">
            {{ 'mine.site_number' | t: number: forloop.index }}
            {%- if block.settings.region != blank %} · {{ block.settings.region }}{% endif -%}
          </p>
          <h2 id="site-title-{{ block.id }}" tabindex="-1">{{ block.settings.title }}</h2>
          {%- if block.settings.minerals != blank -%}
            <p class="mine__known"><span class="label">{{ 'mine.known_for' | t }}</span> {{ block.settings.minerals }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if site_collection != blank -%}
            <p><a href="{{ site_collection.url }}">{{ 'mine.browse' | t }}</a></p>
          {%- endif -%}
        </div>

        <div class="mine__dig" data-dig>
          <div class="mine__face" data-face role="group" aria-label="{{ 'mine.rock_face' | t }}"></div>
          <p class="mine__status" data-status></p>
          <div class="mine__dig-actions">
            <button type="button" class="button button--secondary" data-new-dig hidden>{{ 'mine.new_dig' | t }}</button>
            <button type="button" class="mine__text-button" data-sound-toggle aria-pressed="true" hidden>{{ 'mine.sound_on' | t }}</button>
          </div>
        </div>
      </div>

      <div class="mine__finds-wrap" data-finds-wrap hidden>
        <h3>{{ 'mine.finds_heading' | t }}</h3>
        <ul class="mine__finds" role="list" data-finds></ul>
      </div>

      {%- comment -%} Real, in-stock products for this site. {%- endcomment -%}
      <script type="application/json" data-specimens>
        [
          {%- assign first = true -%}
          {%- for product in site_collection.products limit: 50 -%}
            {%- unless product.available -%}{%- continue -%}{%- endunless -%}
            {%- unless first -%},{%- endunless -%}
            {%- liquid
              assign first = false
              assign variant = product.selected_or_first_available_variant
              assign mf = product.metafields.custom
            -%}
            {
              "id": {{ product.id | json }},
              "variantId": {{ variant.id | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "price": {{ variant.price | money | strip_html | json }},
              "image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 480 | json }}{% else %}null{% endif %},
              "species": {{ product.type | json }},
              "formula": {{ mf.mineral_formula.value | json }},
              "hardness": {{ mf.mohs_hardness.value | json }},
              "locality": {{ mf.locality.value | json }}
            }
          {%- endfor -%}
        ]
      </script>
    </section>
  {%- endfor -%}

  <div class="visually-hidden" aria-live="polite" data-mine-live></div>

  <script type="application/json" data-mine-strings>
    {
      "rock": {{ 'mine.rock' | t | json }},
      "rock_cracked": {{ 'mine.rock_cracked' | t | json }},
      "rock_empty": {{ 'mine.rock_empty' | t | json }},
      "rock_found": {{ 'mine.rock_found' | t | json }},
      "status_start": {{ 'mine.status_start' | t | json }},
      "status_progress": {{ 'mine.status_progress' | t | json }},
      "status_done": {{ 'mine.status_done' | t | json }},
      "status_no_stock": {{ 'mine.status_no_stock' | t | json }},
      "announce_found": {{ 'mine.announce_found' | t | json }},
      "announce_empty": {{ 'mine.announce_empty' | t | json }},
      "site_count": {{ 'mine.site_count' | t | json }},
      "log_total": {{ 'mine.log_total' | t | json }},
      "log_empty": {{ 'mine.log_empty' | t | json }},
      "add": {{ 'products.add_to_cart' | t | json }},
      "adding": {{ 'mine.adding' | t | json }},
      "added": {{ 'mine.added' | t | json }},
      "add_error": {{ 'mine.add_error' | t | json }},
      "view_cart": {{ 'mine.view_cart' | t | json }},
      "details": {{ 'mine.details' | t | json }},
      "sound_on": {{ 'mine.sound_on' | t | json }},
      "sound_off": {{ 'mine.sound_off' | t | json }},
      "hardness": {{ 'products.hardness' | t | json }}
    }
  </script>
</div>

{% schema %}
{
  "name": "Mining game",
  "tag": "section",
  "class": "section-mine",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose a dig site" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Travel to a locality, break the rock and see what turns up. Every find is a real specimen in our stock." },
    { "type": "range", "id": "per_dig", "min": 2, "max": 6, "step": 1, "label": "Specimens hidden per dig", "default": 4 }
  ],
  "blocks": [
    {
      "type": "site",
      "name": "Dig site",
      "settings": [
        { "type": "text", "id": "title", "label": "Site name", "default": "Dig site" },
        { "type": "text", "id": "region", "label": "Region" },
        { "type": "text", "id": "minerals", "label": "Minerals found here" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "In-stock products in this collection are what shoppers can find here." },
        { "type": "number", "id": "latitude", "label": "Latitude", "info": "Between -58 and 80. South is negative.", "default": 0 },
        { "type": "number", "id": "longitude", "label": "Longitude", "info": "Between -180 and 180. West is negative.", "default": 0 },
        { "type": "color", "id": "color", "label": "Site color", "default": "#7b5ea7" },
        {
          "type": "select",
          "id": "rock",
          "label": "Host rock",
          "info": "The kind of rock shoppers break in the 3D dig.",
          "options": [
            { "value": "basalt", "label": "Basalt (dark)" },
            { "value": "granite", "label": "Granite (pale)" },
            { "value": "sandstone", "label": "Sandstone (desert)" },
            { "value": "limestone", "label": "Limestone (tan)" },
            { "value": "slate", "label": "Slate (blue-grey)" }
          ],
          "default": "basalt"
        }
      ]
    }
  ],
  "presets": [{ "name": "Mining game", "blocks": [{ "type": "site" }] }]
}
{% endschema %}
