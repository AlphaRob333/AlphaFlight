<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-experience="{{ settings.default_experience }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%} Apply the shopper's saved experience before first paint. {%- endcomment -%}
    <script>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var ok = { metaphysical: 1, mineral: 1 };
          var q = new URLSearchParams(location.search).get('experience');
          if (ok[q]) localStorage.setItem('crystal_experience', q);
          var v = localStorage.getItem('crystal_experience');
          if (ok[v]) d.setAttribute('data-experience', v);
        } catch (e) {}
      })();
    </script>

    {{ content_for_header }}

    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'experience.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
  </body>
</html>
